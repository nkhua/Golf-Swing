# Mobile client URL. Use your computer's LAN IP for Expo Go on a physical phone.
# Example: EXPO_PUBLIC_BACKEND_URL=http://192.168.1.23:8000
EXPO_PUBLIC_BACKEND_URL=http://YOUR_COMPUTER_LAN_IP:8000

# Expo test modes:
# - server: record real video in Expo, then upload to local backend MediaPipe.
# - auto: try on-device first, then offer backend fallback.
# - mock: use mocked on-device pose frames for UI-only skeleton testing.
EXPO_PUBLIC_ANALYSIS_MODE=auto
EXPO_PUBLIC_ENABLE_MOCK_ON_DEVICE_ANALYSIS=false

APP_ENV=development
DEBUG=false
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOW_EXTERNAL_CONNECTIONS=false
ENABLE_PUBLIC_TUNNEL=false
PROCESS_ON_DEVICE=true

# Safe default: block raw video upload unless explicitly testing server fallback.
ALLOW_VIDEO_UPLOAD=false
STORE_RAW_VIDEO=false
REQUIRE_USER_VIDEO_UPLOAD_CONSENT=true
DELETE_RAW_VIDEO_AFTER_ANALYSIS=true

SAVE_POSE_DATA_ONLY=true
LOG_SENSITIVE_DATA=false
STORE_FRAME_IMAGES=false
STORE_DEBUG_OVERLAYS=false
ENABLE_DETAILED_HAND_TRACKING=false
ANONYMIZE_USER_DATA=true
SEND_VIDEO_TO_LLM=false
SEND_POSE_DATA_TO_LLM=false
SEND_ONLY_SUMMARIZED_METRICS_TO_LLM=true
LLM_SWING_TRIM_MODEL=gpt-4.1-mini
LLM_SWING_TRIM_MAX_FRAMES=12

# Secrets (do not log or expose in EXPO_PUBLIC_* variables)
OPENAI_API_KEY=
DATABASE_URL=
STORAGE_BUCKET=
JWT_SECRET=
