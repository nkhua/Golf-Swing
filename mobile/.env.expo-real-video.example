# Copy this file to mobile/.env when testing real camera footage with Expo Go.
# Replace YOUR_COMPUTER_LAN_IP with the IPv4 address of the computer running the backend.
EXPO_PUBLIC_BACKEND_URL=http://YOUR_COMPUTER_LAN_IP:8000

# Force Expo to use the real-video backend path instead of mock on-device frames.
EXPO_PUBLIC_ANALYSIS_MODE=server
EXPO_PUBLIC_ENABLE_MOCK_ON_DEVICE_ANALYSIS=false

APP_ENV=development
DEBUG=false
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOW_EXTERNAL_CONNECTIONS=true
ENABLE_PUBLIC_TUNNEL=false
PROCESS_ON_DEVICE=true

# Allows explicit-consent upload for local MediaPipe analysis, then deletes raw video.
ALLOW_VIDEO_UPLOAD=true
STORE_RAW_VIDEO=false
REQUIRE_USER_VIDEO_UPLOAD_CONSENT=true
DELETE_RAW_VIDEO_AFTER_ANALYSIS=true

SAVE_POSE_DATA_ONLY=true
LOG_SENSITIVE_DATA=false
STORE_FRAME_IMAGES=false
STORE_DEBUG_OVERLAYS=false
ANONYMIZE_USER_DATA=true
SEND_VIDEO_TO_LLM=false
SEND_POSE_DATA_TO_LLM=false
SEND_ONLY_SUMMARIZED_METRICS_TO_LLM=true
LLM_SWING_TRIM_MODEL=gpt-4.1-mini
LLM_SWING_TRIM_MAX_FRAMES=12

OPENAI_API_KEY=
DATABASE_URL=
STORAGE_BUCKET=
JWT_SECRET=
